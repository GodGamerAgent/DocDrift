# ============================================================================
# DocDrift Environment Variables (.env.example)
# ============================================================================
# NOTE: Zero environment variables are required to run DocDrift out of the box!
#
# 1. AI Model Configuration (Optional)
# In cloud / preview environments, GEMINI_API_KEY is automatically provided and
# routes inference to Gemma 4 (gemma-4-26b-a4b-it).
GEMINI_API_KEY=

# If running LM Studio locally, set the local OpenAI-compatible server URL:
LMSTUDIO_ENDPOINT=http://localhost:1234/v1

# 2. GitHub Pull Request Creator (Optional)
# Used by the One-Click GitHub PR Creator (/api/github/pr).
# If omitted, DocDrift automatically falls back to your local `gh auth login` session.
GITHUB_TOKEN=
